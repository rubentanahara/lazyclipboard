{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lazyclipboard",
  "identifier": "io.github.rubentanahara.lazyclipboard",
  "build": {
    "beforeDevCommand": "pnpm --filter @lazyclipboard/ui dev",
    "beforeBuildCommand": "pnpm build:ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "lazyclipboard",
        "url": "src/windows/panel/index.html",
        "visible": false
      },
      {
        "label": "main",
        "title": "lazyclipboard",
        "url": "src/windows/main/index.html"
      },
      {
        "label": "settings",
        "title": "lazyclipboard",
        "url": "src/windows/settings/index.html",
        "create": false
      },
      {
        "label": "onboarding",
        "title": "lazyclipboard",
        "url": "src/windows/onboarding/index.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
