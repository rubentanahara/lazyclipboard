{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "r0-macos",
  "identifier": "io.github.rubentanahara.lazyclipboard.r0macos",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "width": 480,
        "height": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/32x32.png"]
  }
}
