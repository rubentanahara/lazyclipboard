{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "r0-linux",
  "version": "0.0.0",
  "identifier": "io.github.rubentanahara.lazyclipboard.r0-linux",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "r0-linux panel",
        "url": "index.html",
        "width": 480,
        "height": 240,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
