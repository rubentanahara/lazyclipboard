{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "r0-wayland",
  "version": "0.0.0",
  "identifier": "dev.lazyclipboard.R0Wayland",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "r0-wayland panel",
        "url": "index.html",
        "width": 480,
        "height": 240,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
