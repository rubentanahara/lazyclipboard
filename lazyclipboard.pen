    {
      "type": "frame",
      "id": "gFdZL",
      "x": 0,
      "y": 0,
      "name": "00 Brief · lazyclipboard",
      "width": 1500,
      "fill": "$surface",
      "layout": "vertical",
      "gap": "$space-2xl",
      "padding": "$space-3xl",
      "children": [
        {
          "type": "frame",
          "id": "nRP6H",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-md",
          "children": [
            {
              "type": "text",
              "id": "vyKZP",
              "name": "Board title",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Brief · lazyclipboard",
              "fontFamily": "$font",
              "fontSize": "$text-board-title",
              "fontWeight": "$fw-bold"
            },
            {
              "type": "text",
              "id": "nUtAd",
              "name": "Board subtitle",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A keyboard-first clipboard organizer for macOS, Windows and Linux. This brief summarises the direction already set in DESIGN.md and built on the canvas (03 Tokens, 04 Components, 05 Screen, 06 Flow). It records intent; it does not reopen it.",
              "fontFamily": "$font",
              "fontSize": "$text-ui",
              "fontWeight": "$fw-regular"
            }
          ]
        },
        {
          "type": "frame",
          "id": "lQUAc",
          "name": "Row · Problem, Solution, Audience",
          "width": "fill_container",
          "gap": "$space-2xl",
          "children": [
            {
              "type": "frame",
              "id": "cPlJa",
              "name": "Problem",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$space-md",
              "children": [
                {
                  "type": "text",
                  "id": "voiNH",
                  "name": "Problem title",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem",
                  "fontFamily": "$font",
                  "fontSize": "$text-title",
                  "fontWeight": "$fw-semibold"
                },
                {
                  "type": "text",
                  "id": "Yrdjv",
                  "name": "Problem body",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The system clipboard holds one thing. Gathering snippets from several windows means switching back and forth, or pasting into a scratch note. Clipboard histories log everything in time order with no labels, so the item you want is buried under the ones you do not.",
                  "fontFamily": "$font",
                  "fontSize": "$text-body",
                  "fontWeight": "$fw-medium"
                }
              ]
            },
            {
              "type": "frame",
              "id": "X7r5z",
              "name": "Solution",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$space-md",
              "children": [
                {
                  "type": "text",
                  "id": "vEpsA",
                  "name": "Solution title",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Solution",
                  "fontFamily": "$font",
                  "fontSize": "$text-title",
                  "fontWeight": "$fw-semibold"
                },
                {
                  "type": "text",
                  "id": "V8AAu",
                  "name": "Solution body",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Copy sends the selection straight to a named group with a global shortcut. Paste opens a floating panel: pick a group, pick an item, press return, and it lands in the active app. AI reformat is an option on any item. Paste All joins a group into one block, with order, separator and an optional AI summary.",
                  "fontFamily": "$font",
                  "fontSize": "$text-body",
                  "fontWeight": "$fw-medium"
                }
              ]
            },
            {
              "type": "frame",
              "id": "P6GHT",
              "name": "Audience and feel",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$space-md",
              "children": [
                {
                  "type": "text",
                  "id": "cRF4D",
                  "name": "Audience and feel title",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Who it is for and how it feels",
